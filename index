<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TheDubaiGuy — Launching Soon</title>
<meta name="description" content="TheDubaiGuy — Dubai inspired modest wear, perfumes, oud, bukhoor and home essentials. Launching 10 October 2026 across Singapore, Malaysia, Indonesia & Brunei.">
<meta property="og:title" content="TheDubaiGuy — Launching Soon">
<meta property="og:description" content="Dubai Inspired. Made for You. Launching 10 October 2026.">
<meta property="og:type" content="website">
<meta property="og:url" content="https://thedubaiguy.shop/">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root{--cream:#f6efe2;--muted:#d8cbb2;--gold:#e0bd79;--gold-deep:#b5924e;--line:rgba(224,189,121,.34)}
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{height:100%}
  body{background:#14110e;color:var(--cream);font-family:"Jost",-apple-system,Segoe UI,sans-serif;font-weight:300;
    min-height:100vh;display:flex;align-items:center;justify-content:flex-start;
    padding:40px;position:relative;overflow-x:hidden}
  .bg{position:fixed;inset:0;z-index:0;background:url("data:image/jpeg;base64,") center right/cover no-repeat;transform:scale(1.02)}
  /* gradient: light at top, dark at the bottom */
  .scrim{position:fixed;inset:0;z-index:1;background:
      linear-gradient(180deg, rgba(14,11,8,.10) 0%, rgba(14,11,8,.30) 42%, rgba(12,9,6,.86) 100%),
      linear-gradient(90deg, rgba(12,9,6,.55) 0%, rgba(12,9,6,.28) 42%, rgba(12,9,6,0) 72%)}
  .frame{position:fixed;inset:16px;border:1px solid var(--line);pointer-events:none;z-index:3;border-radius:2px}
  /* Content column — centred text, placed on the LEFT (desktop) */
  .wrap{position:relative;z-index:4;width:100%;max-width:470px;text-align:center;
    margin-left:clamp(20px,7vw,110px);padding:20px 0}
  .eyebrow{font-size:13px;letter-spacing:.46em;text-transform:uppercase;color:var(--gold);margin-bottom:16px;font-weight:400}
  h1{font-family:"Cormorant Garamond",Georgia,serif;font-weight:500;font-size:clamp(46px,7vw,72px);line-height:1;letter-spacing:.5px;margin-bottom:14px;text-shadow:0 2px 34px rgba(0,0,0,.55)}
  .tagline{font-family:"Cormorant Garamond",Georgia,serif;font-style:italic;font-size:clamp(18px,3.2vw,23px);color:var(--muted);margin-bottom:30px;text-shadow:0 1px 16px rgba(0,0,0,.6)}
  /* Countdown */
  .countdown{display:flex;justify-content:center;gap:14px;margin-bottom:14px}
  .cd-cell{min-width:66px}
  .cd-num{font-family:"Cormorant Garamond",serif;font-weight:600;font-size:clamp(34px,5vw,46px);line-height:1;color:var(--cream);text-shadow:0 2px 20px rgba(0,0,0,.6)}
  .cd-lab{font-size:9.5px;letter-spacing:.24em;text-transform:uppercase;color:var(--gold);margin-top:8px}
  .cd-sep{font-family:"Cormorant Garamond",serif;font-size:34px;color:var(--gold);opacity:.5;line-height:1.1}
  .launch-date{font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin-bottom:32px;text-shadow:0 1px 12px rgba(0,0,0,.6)}
  /* Notify */
  form.sub{display:flex;gap:9px;margin:0 auto 12px;max-width:410px}
  input{flex:1;min-width:0;background:rgba(20,16,11,.5);border:1px solid var(--line);color:var(--cream);
    padding:14px 16px;font-family:inherit;font-size:13.5px;letter-spacing:.02em;border-radius:2px;outline:none;transition:border-color .2s;backdrop-filter:blur(4px)}
  input::placeholder{color:#b3a488}
  input:focus{border-color:var(--gold)}
  button{background:linear-gradient(180deg,var(--gold),var(--gold-deep));color:#1a1509;border:none;
    padding:14px 24px;font-family:"Jost",sans-serif;font-weight:500;font-size:11.5px;letter-spacing:.2em;text-transform:uppercase;
    cursor:pointer;border-radius:2px;transition:transform .15s,box-shadow .2s;white-space:nowrap}
  button:hover{transform:translateY(-1px);box-shadow:0 8px 26px rgba(224,189,121,.35)}
  .note{font-size:11.5px;color:#b3a488;letter-spacing:.03em;min-height:16px;transition:color .3s;text-shadow:0 1px 10px rgba(0,0,0,.6);margin-bottom:30px}
  .note.ok{color:var(--gold)}
  /* Socials + contact + countries */
  .socials{display:flex;gap:16px;justify-content:center;margin-bottom:22px}
  .socials a{width:38px;height:38px;border:1px solid var(--line);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--muted);transition:all .2s;background:rgba(20,16,11,.35);backdrop-filter:blur(4px)}
  .socials a:hover{color:var(--gold);border-color:var(--gold);transform:translateY(-2px)}
  .socials svg{width:16px;height:16px;fill:currentColor}
  .contact{display:flex;gap:8px 22px;justify-content:center;flex-wrap:wrap;font-size:12.5px;letter-spacing:.03em;margin-bottom:16px}
  .contact a{color:var(--muted);text-decoration:none;transition:color .2s;border-bottom:1px solid transparent;padding-bottom:2px;text-shadow:0 1px 10px rgba(0,0,0,.6)}
  .contact a:hover{color:var(--gold);border-bottom-color:var(--line)}
  .regions{font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:#c3b493;margin-bottom:34px;text-shadow:0 1px 10px rgba(0,0,0,.6)}
  /* Logo at the bottom */
  .logo{width:min(230px,64vw);height:auto;display:block;margin:0 auto 10px;filter:drop-shadow(0 2px 20px rgba(0,0,0,.7))}
  .copyright{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#9c8f77;line-height:1.9;text-shadow:0 1px 10px rgba(0,0,0,.6)}
  .admin-link{display:inline-flex;align-items:center;gap:6px;margin-top:16px;font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;color:#8a7d68;cursor:pointer;text-decoration:none;transition:color .2s}
  .admin-link:hover{color:var(--gold)}
  .admin-link svg{width:11px;height:11px;fill:currentColor}
  /* Admin overlay */
  .overlay{position:fixed;inset:0;z-index:20;display:none;align-items:center;justify-content:center;padding:24px;background:rgba(8,6,4,.72);backdrop-filter:blur(8px)}
  .overlay.show{display:flex}
  .panel{position:relative;width:100%;max-width:400px;background:linear-gradient(180deg,#1d1812,#161109);border:1px solid var(--line);border-radius:6px;padding:40px 34px 34px;text-align:center;box-shadow:0 30px 80px rgba(0,0,0,.6)}
  .panel .crest{width:52px;height:52px;margin:0 auto 18px;border:1px solid var(--line);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--gold)}
  .panel .crest svg{width:22px;height:22px;fill:currentColor}
  .panel h2{font-family:"Cormorant Garamond",serif;font-weight:500;font-size:26px;letter-spacing:.5px;margin-bottom:6px}
  .panel .sub{font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:var(--muted);margin-bottom:26px}
  .panel form{display:flex;flex-direction:column;gap:12px}
  .panel input{width:100%;text-align:left}
  .panel button{width:100%;margin-top:4px;padding:14px}
  .panel .err{min-height:16px;font-size:12px;color:#e08d7a;letter-spacing:.02em;margin-top:2px}
  .panel .close{position:absolute;top:12px;right:14px;background:none;border:none;color:#8a7d6a;font-size:22px;cursor:pointer;padding:4px 8px;box-shadow:none;line-height:1}
  .panel .close:hover{color:var(--cream)}
  .panel .hint{font-size:10.5px;color:#6f6452;letter-spacing:.05em;margin-top:16px;line-height:1.7}
  .granted{display:none}.granted.show{display:block;animation:fade .4s ease}
  @keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
  .granted .ok-badge{color:var(--gold);font-size:12px;letter-spacing:.2em;text-transform:uppercase;margin-bottom:14px}
  .spinner{width:26px;height:26px;margin:6px auto 0;border:2px solid rgba(224,189,121,.25);border-top-color:var(--gold);border-radius:50%;animation:spin .8s linear infinite}
  @keyframes spin{to{transform:rotate(360deg)}}
  /* MOBILE: centre content + centre the lady in the background */
  @media(max-width:760px){
    body{justify-content:center;padding:34px 22px}
    .wrap{margin:0 auto;max-width:440px}
    .bg{background-position:72% center}
    .scrim{background:
      linear-gradient(180deg, rgba(14,11,8,.28) 0%, rgba(14,11,8,.42) 40%, rgba(12,9,6,.9) 100%)}
    .frame{inset:10px}
    .cd-cell{min-width:52px}
    .countdown{gap:8px}
  }
</style>
</head>
<body>
  <div class="bg"></div>
  <div class="scrim"></div>
  <div class="frame"></div>

  <div class="wrap">
    <div class="eyebrow">The Dubai Guy</div>
    <h1>Launching Soon</h1>
    <div class="tagline">Dubai Inspired. Made for You.</div>

    <div class="countdown" id="countdown" aria-label="Countdown to launch">
      <div class="cd-cell"><div class="cd-num" id="cd-d">00</div><div class="cd-lab">Days</div></div>
      <div class="cd-sep">:</div>
      <div class="cd-cell"><div class="cd-num" id="cd-h">00</div><div class="cd-lab">Hours</div></div>
      <div class="cd-sep">:</div>
      <div class="cd-cell"><div class="cd-num" id="cd-m">00</div><div class="cd-lab">Minutes</div></div>
      <div class="cd-sep">:</div>
      <div class="cd-cell"><div class="cd-num" id="cd-s">00</div><div class="cd-lab">Seconds</div></div>
    </div>
    <div class="launch-date" id="launchDate">10 October 2026 · 12:00 PM (SGT)</div>

    <form class="sub" onsubmit="subscribe(event)">
      <input type="email" required placeholder="Your email address" aria-label="Email address">
      <button type="submit">Notify Me</button>
    </form>
    <div class="note" id="note">Be the first to know when we open &amp; unlock private offers.</div>

    <div class="socials">
      <a href="https://www.instagram.com/thedubaiguy" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24"><path d="M12 2.2c3.2 0 3.6 0 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s0 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58 0-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.21 15.58 2.2 15.2 2.2 12s0-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.21 8.8 2.2 12 2.2zm0 1.8c-3.14 0-3.51.01-4.75.07-.9.04-1.38.19-1.71.32-.43.17-.74.37-1.06.69-.32.32-.52.63-.69 1.06-.13.33-.28.81-.32 1.71C3.21 8.49 3.2 8.86 3.2 12s.01 3.51.07 4.75c.04.9.19 1.38.32 1.71.17.43.37.74.69 1.06.32.32.63.52 1.06.69.33.13.81.28 1.71.32 1.24.06 1.61.07 4.75.07s3.51-.01 4.75-.07c.9-.04 1.38-.19 1.71-.32.43-.17.74-.37 1.06-.69.32-.32.52-.63.69-1.06.13-.33.28-.81.32-1.71.06-1.24.07-1.61.07-4.75s-.01-3.51-.07-4.75c-.04-.9-.19-1.38-.32-1.71a2.85 2.85 0 0 0-.69-1.06 2.85 2.85 0 0 0-1.06-.69c-.33-.13-.81-.28-1.71-.32C15.51 4.01 15.14 4 12 4zm0 3.06A4.94 4.94 0 1 1 12 16.94 4.94 4.94 0 0 1 12 7.06zm0 8.14A3.2 3.2 0 1 0 12 8.8a3.2 3.2 0 0 0 0 6.4zm6.3-8.34a1.15 1.15 0 1 1-2.3 0 1.15 1.15 0 0 1 2.3 0z"/></svg></a>
      <a href="https://www.tiktok.com/@thedubaiguy" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24"><path d="M16.6 5.82a4.28 4.28 0 0 1-1.02-2.82h-3.1v12.28a2.35 2.35 0 0 1-2.35 2.28 2.35 2.35 0 1 1 .6-4.62V9.77a5.47 5.47 0 0 0-.6-.03 5.45 5.45 0 1 0 5.45 5.45V9.01a7.3 7.3 0 0 0 4.27 1.37V7.28a4.28 4.28 0 0 1-3.25-1.46z"/></svg></a>
    </div>

    <div class="contact">
      <a href="https://wa.me/971529911745" target="_blank" rel="noopener">WhatsApp +971 052 991 1745</a>
      <a href="mailto:hello@thedubaiguy.com">HELLO@THEDUBAIGUY.COM</a>
    </div>
    <div class="regions">Singapore · Malaysia · Indonesia · Brunei</div>

    <img class="logo" src="data:image/png;base64," alt="TheDubaiGuy">
    <div class="copyright">TheDubaiGuy © 2026 · The Dubai Guy Pte. Ltd · All Rights Reserved</div>

    <a class="admin-link" onclick="openAdmin()" title="Administrator access">
      <svg viewBox="0 0 24 24"><path d="M12 1 3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
      Administrator Login
    </a>
  </div>

  <div class="overlay" id="adminOverlay" onclick="if(event.target===this)closeAdmin()">
    <div class="panel">
      <button class="close" onclick="closeAdmin()" aria-label="Close">&times;</button>
      <div id="loginView">
        <div class="crest"><svg viewBox="0 0 24 24"><path d="M12 1 3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg></div>
        <h2>Administrator Login</h2>
        <div class="sub">TheDubaiGuy Storefront</div>
        <form onsubmit="adminLogin(event)">
          <input type="text" id="adminUser" placeholder="Username or email" autocomplete="username" aria-label="Username">
          <input type="password" id="adminPass" placeholder="Password" autocomplete="current-password" aria-label="Password" required>
          <button type="submit">Sign In &amp; Enter Store</button>
          <div class="err" id="adminErr"></div>
        </form>
        <div class="hint">Authorised personnel only. Signing in opens the live storefront.</div>
      </div>
      <div class="granted" id="grantedView">
        <div class="crest"><svg viewBox="0 0 24 24"><path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg></div>
        <div class="ok-badge">Access Granted</div>
        <h2 style="margin-bottom:10px">Entering storefront…</h2>
        <div class="spinner"></div>
      </div>
    </div>
  </div>

<script>
  /* ===== LAUNCH COUNTDOWN — change the target date/time here ===== */
  var LAUNCH = new Date("2026-10-10T12:00:00+08:00"); // 10 Oct 2026, 12:00 noon Singapore time
  function pad(n){return (n<10?"0":"")+n;}
  function tick(){
    var now=new Date(), diff=LAUNCH-now;
    if(diff<=0){
      document.getElementById("countdown").innerHTML='<div style="font-family:Cormorant Garamond,serif;font-size:34px;color:var(--gold)">We\'re Live!</div>';
      document.getElementById("launchDate").textContent="The storefront is now open.";
      clearInterval(window._cdT); return;
    }
    var s=Math.floor(diff/1000);
    document.getElementById("cd-d").textContent=pad(Math.floor(s/86400));
    document.getElementById("cd-h").textContent=pad(Math.floor(s%86400/3600));
    document.getElementById("cd-m").textContent=pad(Math.floor(s%3600/60));
    document.getElementById("cd-s").textContent=pad(s%60);
  }
  tick(); window._cdT=setInterval(tick,1000);

  /* ===== ADMIN LOGIN — edit these two values ===== */
  var ADMIN_CONFIG = { password: "0529911745", storeUrl: "store.html" };

  function subscribe(e){e.preventDefault();var n=document.getElementById("note");
    n.textContent="Thank you — you're on the list. We'll be in touch. ✨";n.classList.add("ok");e.target.reset();}
  function openAdmin(){document.getElementById("adminOverlay").classList.add("show");
    document.getElementById("loginView").style.display="block";
    document.getElementById("grantedView").classList.remove("show");
    document.getElementById("adminErr").textContent="";
    setTimeout(function(){var p=document.getElementById("adminPass");if(p)p.focus();},60);}
  function closeAdmin(){document.getElementById("adminOverlay").classList.remove("show");}
  function adminLogin(e){e.preventDefault();
    var pass=document.getElementById("adminPass").value, err=document.getElementById("adminErr");
    if(pass===ADMIN_CONFIG.password){
      document.getElementById("loginView").style.display="none";
      document.getElementById("grantedView").classList.add("show");
      setTimeout(function(){window.location.href=ADMIN_CONFIG.storeUrl;},900);
    } else { err.textContent="Incorrect password. Please try again.";
      document.getElementById("adminPass").value="";document.getElementById("adminPass").focus();}
  }
  if(location.hash==="#admin") openAdmin();
  window.addEventListener("keydown",function(ev){if(ev.key==="Escape")closeAdmin();});
</script>
</body>
</html>
